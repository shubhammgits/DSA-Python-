   "source": [
    "## Find the startign point of the cycle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d7204554",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sol(head):\n",
    "    temp = head\n",
    "    myset = set()\n",
    "\n",
    "    while temp is not None:\n",
    "        if temp in myset:\n",
    "            return temp\n",
    "        myset.add(temp)\n",
    "        temp=temp.next\n",
    "\n",
    "    return None"
   ]
  }
 ],
