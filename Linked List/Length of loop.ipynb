   "source": [
    "## Length of loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8e8a1dce",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sol(head):\n",
    "    temp=head\n",
    "    travel=0\n",
    "    mydict = {}\n",
    "\n",
    "    while temp is not None:\n",
    "\n",
    "        if temp in mydict:\n",
    "            return travel - mydict[temp] \n",
    "           \n",
    "        mydict[temp] = travel\n",
    "        travel+=1\n",
    "        temp=temp.next\n",
    "\n",
    "    return 0\n",
    "            "
   ]
  }
