   "source": [
    "## Sorting linked list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9659865d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sol(head):\n",
    "    temp=head\n",
    "    arr=[]\n",
    "\n",
    "    while temp is not None:\n",
    "        arr.append(temp.val)\n",
    "        temp=temp.next\n",
    "\n",
    "    arr.sort()\n",
    "    temp=head    \n",
    "    for x in arr:\n",
    "        temp.val=x\n",
    "        temp=temp.next\n",
    "\n",
    "    return head\n"
   ]
  },
