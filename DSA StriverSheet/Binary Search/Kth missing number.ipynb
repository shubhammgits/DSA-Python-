   "source": [
    "#brute:\n",
    "\n",
    "arr = [2,3,5,7,11]\n",
    "k = 5\n",
    "n = len(arr)\n",
    "\n",
    "for i in range(n):\n",
    "    if arr[i]<=k:\n",
    "        k+=1\n",
    "    else:\n",
    "        break\n",
    "\n",
    "print(k)\n"
   ]
  }
