    "## Pascals Triangle"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "67910bac",
   "metadata": {},
   "source": [
    "#### Type 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b0746f30",
   "metadata": {},
   "outputs": [],
   "source": [
    "def func(n,r):\n",
    "    res = 1\n",
    "    for i in range(r):\n",
    "        res = res * (n-i)\n",
    "        res = res/i+1\n",
    "\n",
    "    return res"
   ]
