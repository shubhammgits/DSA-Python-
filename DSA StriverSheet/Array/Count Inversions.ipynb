   "source": [
    "#brute:\n",
    "\n",
    "arr = [5,4,3,2,1]\n",
    "n = len(arr)\n",
    "count=0\n",
    "\n",
    "for i in range(n):\n",
    "    for j in range(i+1,n):\n",
    "        if arr[i]>arr[j]:\n",
    "            count+=1\n",
    "\n",
    "print(count)"
   ]
  }
