   "source": [
    "class Solution:\n",
    "    def minBishopMoves(self, source: list[int], target: list[int]) -> int:\n",
    "\n",
    "        s1,s2 = source\n",
    "        t1,t2 = target\n",
    "\n",
    "        if (s1+s2)%2 != (t1+t2)%2:\n",
    "            return -1\n",
    "\n",
    "        if abs(s1-t1) == abs(s2-t2):\n",
    "            return 1\n",
    "\n",
    "        return 2"
   ]
  }
 ],
